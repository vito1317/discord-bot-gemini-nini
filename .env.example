# Discord Bot Token（從 Discord Developer Portal 取得）
DISCORD_TOKEN=your_discord_bot_token_here

# LM Studio API 設定（預設為本機）
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3.5-35b-a3b

# 機器人設定
BOT_NAME=奈奈
# 自動情緒偵測的頻道 ID（以逗號分隔，留空則監聽所有頻道）
MONITORED_CHANNELS=
# 情緒偵測冷卻時間（秒），避免同一使用者被頻繁回應
COOLDOWN_SECONDS=120
# 危險訊息警告頻道 ID（偵測到自傷等危險訊息時，會發送警告到此頻道）
ALERT_CHANNEL_ID=

# 觸發關鍵字（包含這些關鍵字的訊息會觸發 AI 回應，以逗號分隔）
TRIGGER_KEYWORDS=奈奈,nana

# Freeze-Omni 語音 AI 設定（語音頻道功能）
FREEZE_OMNI_URL=http://127.0.0.1:8891
VOICE_SYSTEM_PROMPT=你是「奈奈」，一位溫暖親切的語音 AI 夥伴。請用台灣繁體中文回答，語氣自然口語化，回答要簡短精要（因為這是語音對話）。你的個性溫暖、有同理心，善於傾聽與陪伴。
