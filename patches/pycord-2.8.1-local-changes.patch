+def _looks_like_opus(b: bytes) -> str:
+    """粗略判斷是不是合法 opus 開頭。
+
+    Opus 的第一個 byte 是 TOC：高 5 bits 是 config(0-31)，bit2 是 stereo，
+    低 2 bits 是 frame count code。Discord 語音常見 0x78/0xb8/0xfc，
+    靜音框固定是 F8 FF FE。
+    """
+    if not b:
+        return "空"
+    if b[:3] == b"\xf8\xff\xfe":
+        return "靜音框"
+    toc = b[0]
+    cfg = toc >> 3
+    return f"TOC=0x{toc:02x} config={cfg} {'合理' if cfg >= 12 else '可疑'}"
+
+
+def _hexdump_stages(packet, raw_payload, dave_out, offset, stripped) -> None:
